# Скопировать в .env в корне проекта. Кавычки и export не нужны.
SERVER_PORT=8080
DB_URL=jdbc:h2:file:./data/students
DB_USERNAME=sa
DB_PASSWORD=
APP_LOG_LEVEL=INFO

# Пример для локальной лабораторной. Заменить ключ и пароль перед использованием.
JWT_SECRET=change-this-secret-key-at-least-32-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Чтобы сменить пароль существующего ADMIN, изменить значение и перезапустить приложение.
ADMIN_PASSWORD=change-me-admin
